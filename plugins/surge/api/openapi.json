{
  "openapi": "3.1.0",
  "info": {
    "title": "Surge plugin reports",
    "version": "1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ModuleStatus": {
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "../../../docs/api/openapi.json#/components/schemas/ScriptTaskStatus"
            }
          },
          "body_rewrites": {
            "format": "int64",
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "header_rewrites": {
            "format": "int64",
            "type": "integer"
          },
          "host_mappings": {
            "format": "int64",
            "type": "integer"
          },
          "hostnames": {
            "format": "int64",
            "type": "integer"
          },
          "instance": {
            "type": "string"
          },
          "map_locals": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "rules": {
            "format": "int64",
            "type": "integer"
          },
          "scripts": {
            "format": "int64",
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "url_rewrites": {
            "format": "int64",
            "type": "integer"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "source",
          "state",
          "scripts",
          "hostnames",
          "host_mappings",
          "url_rewrites",
          "header_rewrites",
          "body_rewrites",
          "map_locals",
          "rules",
          "warnings"
        ],
        "type": "object"
      },
      "SurgeStatus": {
        "properties": {
          "runtimes": {
            "type": "array",
            "description": "Selected JavaScript runtime for this instance. Clients preserve instance identity when combining reports.",
            "items": {
              "$ref": "#/components/schemas/SurgeRuntimeStatus"
            }
          },
          "notifications": {
            "type": "array",
            "description": "All retained explicit script notifications for this instance, newest first. Each script (module, script name and script type) retains up to 50 messages within a shared conservative 1 MiB JSON budget. The longest histories lose their oldest entries first; ties remove the oldest entry, so fewer than 50 messages may remain per script. CLI text defaults to 3 per script; --verbose and JSON show all retained messages. In-memory history resets on reload and is independent of the log level and script success.",
            "items": {
              "$ref": "#/components/schemas/SurgeNotification"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleStatus"
            },
            "type": "array"
          }
        },
        "required": [
          "enabled",
          "modules"
        ],
        "type": "object"
      },
      "SurgeRuntimeStatus": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string",
            "description": "Added by clients when combining plugin reports."
          },
          "backend": {
            "type": "string",
            "enum": [
              "quickjs",
              "nodejs"
            ]
          },
          "nodejs": {
            "$ref": "#/components/schemas/NodeJSRuntimeStatus"
          }
        },
        "required": [
          "backend"
        ]
      },
      "NodeJSRuntimeStatus": {
        "type": "object",
        "description": "Live pool counts and pool-lifetime counters excluding startup probes and shutdown. RSS/PSS are cached sums for memory_sampled_workers; failed or pending samples are excluded. Status collection performs no process I/O.",
        "properties": {
          "active": {
            "type": "integer",
            "description": "Leased workers, including startup and waiting for host I/O."
          },
          "idle": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "started": {
            "type": "integer"
          },
          "reused": {
            "type": "integer"
          },
          "start_failures": {
            "type": "integer"
          },
          "idle_reaped": {
            "type": "integer"
          },
          "discarded": {
            "type": "integer",
            "description": "Workers discarded after errors or cancellation."
          },
          "rss_bytes": {
            "type": "integer",
            "description": "Sum of sampled RSS; shared pages can be counted more than once."
          },
          "pss_bytes": {
            "type": "integer",
            "description": "Sum of sampled PSS, proportionally accounting for shared pages."
          },
          "memory_sampled_workers": {
            "type": "integer"
          },
          "memory_sampled_at": {
            "type": "string",
            "format": "date-time",
            "description": "Oldest memory sample included in the sums; omitted when no workers are sampled."
          },
          "idle_timeout_seconds": {
            "type": "number"
          }
        },
        "required": [
          "active",
          "idle",
          "limit",
          "started",
          "reused",
          "start_failures",
          "idle_reaped",
          "discarded",
          "rss_bytes",
          "pss_bytes",
          "memory_sampled_workers",
          "idle_timeout_seconds"
        ]
      },
      "SurgeNotification": {
        "type": "object",
        "description": "Text supplied by $notification.post. Module, script, title and subtitle are capped at 1024 UTF-8 bytes each; body at 4096 bytes. Original line breaks are retained. Extra notification options are ignored.",
        "properties": {
          "instance": {
            "type": "string",
            "description": "Added by clients when combining plugin reports."
          },
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Per-instance arrival sequence, reset on reload."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "module": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "script_type": {
            "type": "string",
            "enum": [
              "http-request",
              "http-response",
              "dns",
              "cron",
              "generic"
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean",
            "description": "True when any text field was shortened to its byte limit."
          }
        },
        "required": [
          "id",
          "created_at",
          "module",
          "script",
          "script_type",
          "title",
          "subtitle",
          "body"
        ]
      }
    }
  }
}
