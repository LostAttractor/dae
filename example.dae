# Configuration can be split into files below the entry configuration directory:
# include {
#     config.d/*.dae
#     /etc/dae/config.d/*.dae
# }
# Relative include paths are resolved from the entry configuration directory. Absolute paths are used as-is.
# Each routing fragment file needs a routing { ... } wrapper. Declare each rule_set, default and interface
# profile once, then compose them with ordered use statements. See docs/en/configuration/separate-config.md.
# DAE_LOCATION_CACHE sets the writable state directory (default: /var/lib/dae) for CA files,
# explicit remote caches, relative Surge file: module sources, MITM certificate paths and plugin state.
# The configuration directory may remain read-only. See docs/zh/configuration/cache-directory.md.

global {
    # Network-first cache for HTTP/HTTPS subscriptions, Surge modules and dependencies.
    # Failed downloads/validation reuse the last complete validated snapshot.
    # false disables cache reads, writes and cleanup; existing files are retained.
    resource_cache: true
    ##### Software options.

    # Internal transparent-proxy listener port. It is not an HTTP/SOCKS port and normally does not need to be changed.
    tproxy_port: 12345

    # Set it true to protect tproxy port from unsolicited traffic. Set it false to allow users to use self-managed
    # iptables tproxy rules.
    tproxy_port_protect: true

    # Set non-zero value to enable pprof.
    pprof_port: 0

    # Set non-zero value to enable the Prometheus metrics endpoint.
    metrics_port: 0

    # Device settings, selectors and certificate downloads. Zero disables the HTTP page/API.
    api_port: 0
    # Optional: when unset, verified direct LAN clients can view status and change selectors without login.
    # When set, administration requires this key. Device settings always require direct LAN identification.
    #api_key: 'replace-with-a-private-key'

    # SO_MARK applied to traffic and hostname lookups sent by dae to prevent them from being captured again. Zero uses
    # the reserved internal mark 0x100. Set a non-zero value only when policy-routing rules require it, ensure no unrelated
    # fwmark rule matches the value, and restart
    # dae after changing it. Values containing dae's reserved tproxy bit 0x08000000 are rejected. Marked lookups use
    # Go's resolver, so hostname sources provided only by libc NSS modules are not supported.
    so_mark_from_dae: 0

    # Log level: error (feature failure), warn (degradation), info (lifecycle and availability),
    # debug (connections and requests), trace (packets and processing steps).
    # Surge console.log/info use info; console.debug/warn/error use their corresponding levels.
    log_level: info

    # Disable waiting for network before pulling subscriptions.
    disable_waiting_network: false

    # Sliding domain-IP retention policy, not a measured client cache lifetime.
    # Delivered DNS uses max(TTL, window); observed traffic refreshes existing pairs.
    # Uncaptured kernel-direct traffic does not refresh evidence in this version.
    dns_retention_window: 168h

    # Optional DNS server for dae's internal lookups; IP or IP:port (default 53).
    # Unset uses Go's system resolver. Bootstrap is direct; after startup, DNS
    # transports follow routing. Proxy-server names always use direct bootstrap.
    # dns_resolver: '1.1.1.1:53'

    ##### Interface and kernel options.

    # The LAN interface to bind. Use it if you want to proxy LAN.
    # Multiple interfaces split by ",".
    #lan_interface: docker0

    # The WAN interface to bind. Use it if you want to proxy localhost.
    # Multiple interfaces split by ",". Use "auto" to auto detect.
    wan_interface: auto

    # Automatically configure Linux kernel parameters like ip_forward and send_redirects. Check out
    # https://github.com/daeuniverse/dae/blob/main/docs/en/user-guide/kernel-parameters.md to see what will dae do.
    auto_config_kernel_parameter: true

    ##### Node connectivity check.
    # These options, as defaults, are effective when no definition is given in the group.

    # This DNS will be used to check UDP connectivity of nodes. And if dns_upstream below contains tcp, it also be used to check
    # TCP DNS connectivity of nodes.
    # First is URL, others are IP addresses if given.
    # This DNS should have both IPv4 and IPv6 if you have double stack in local.
    #udp_check_dns: 'dns.google:53'
    udp_check_dns: 'dns.google:53,8.8.8.8,2001:4860:4860::8888'

    # Check interval while the node is alive. Failed check rounds retry from 1s with exponential backoff.
    check_interval: 3m
    # Maximum interval for failed health checks and connectivity-mode support retries.
    check_interval_max: 1h

    # Outside first support confirmation for a mode, a new node must improve latency by more than this value.
    check_tolerance: 50ms


    ##### Connecting options.

    # Use the sniffed domain to override the dial target (destination) when it is available and verified.
    # This will relieve DNS pollution problem to a great extent if you have impure DNS environment. Generally,
    # it brings faster proxy response time because the proxy will re-resolve the domain in remote, thus get
    # better IP result to connect. Set it false to dial using the destination IP. Explicit DNAT/Host IP
    # rewrites take precedence over this option. Sniffing will be disabled if reroute_mode is also "none".
    dial_target_override: true

    # Whether to re-route traffic using the sniffed domain. Optional values:
    # 1. "none". Never re-route using the sniffed domain. Routing decisions purely rely on the original
    #       destination (IP/port). Sniffed domains are only used to override the dial target (see
    #       dial_target_override).
    # 2. "while_needed". Re-route using the sniffed domain only when the kernel may not have routed correctly,
    #       e.g. the sniffed domain is not backed by a DNS lookup that went through dae. This is the default
    #       and recovers most domain based traffic split ability in such cases.
    # 3. "force". Always re-route traffic using the sniffed domain. It fully recovers domain based traffic
    #       split ability but consumes more CPU resources.
    reroute_mode: while_needed

    # How strictly the sniffed domain is verified before being trusted. Optional values:
    # 1. "none". Trust any sniffed domain.
    # 2. "loose". Trust the sniffed domain if it looks like a real domain (it has A/AAAA records). This is
    #       the default.
    # 3. "strict". Trust the sniffed domain only if the destination IP matches a DNS record of the domain
    #       that was resolved through dae. It is the most reliable but requires DNS requests to go through dae.
    sniff_verify_mode: loose

    # Allow insecure TLS certificates. It is not recommended to turn it on unless you have to.
    allow_insecure: false

    # Timeout to waiting for first data sending for sniffing. It is always 0 if sniffing is not needed
    # (dial_target_override is false and reroute_mode is "none"). Set it higher is useful in high latency
    # LAN network.
    sniffing_timeout: 100ms

    # TLS implementation. tls is to use Go's crypto/tls. utls is to use uTLS, which can imitate browser's Client Hello.
    tls_implementation: tls

    # The Client Hello ID for uTLS to imitate. This takes effect only if tls_implementation is utls.
    # See more: https://github.com/daeuniverse/dae/blob/331fa23c16/component/outbound/transport/tls/utls.go#L17
    utls_imitate: chrome_auto

    # TLS fragmentation support. If is true, dae will send Client Hello in fragments to bypass SNI blocking.
    tls_fragment: false

    # TLS fragment packet length range, in bytes. The length of each fragment is randomly generated from this range.
    tls_fragment_length: '50-100'

    # TLS fragment packet length, in milliseconds. Each fragment interval is randomly generated from this range.
    tls_fragment_interval: '10-20'

    # Multipath TCP (MPTCP) support. If is true, dae will try to use MPTCP to connect all nodes, but it will only take
    # effects when the node supports MPTCP. It can use for load balance and failover to multiple interfaces and IPs.
    mptcp: false

    # The UDP port hopping interval for protocols that support it (e.g., Hysteria2 with a port range).
    #udphop_interval: 30s

    # The maximum bandwidth for accessing the Internet. It is useful for some specific protocols (e.g., Hysteria2),
    # which will perform better with bandwith information provided. The unit can be b, kb, mb, gb, tb or bytes per second.
    # supported formats: https://v2.hysteria.network/docs/advanced/Full-Client-Config/#bandwidth
    bandwidth_max_tx: '200 mbps' # uplink, or '200 m' or '200 mb' or '200 mbps' or 25000000(which is 200/8*1000*1000)
    bandwidth_max_rx: '1 gbps' # downlink, or '1 g' or '1 gb' or '1 gbps' or 125000000(which is 1000/8*1000*1000)

    # Internal lookups use the marked Go resolver, optionally overridden by
    # dns_resolver above. No DNS plugin is needed for dae's own lookups.

    # Behavior when all nodes of a group have no connectivity.
    # If no_connectivity_try_sniff is true (default), traffic of the group is still sent to the control plane
    # so that sniffing and re-routing may recover it. If it is false, traffic immediately falls back to
    # no_connectivity_behavior.
    #no_connectivity_try_sniff: true

    # What to do with traffic when the group has no connectivity (and no_connectivity_try_sniff does not
    # apply): "block" (default) drops it; "direct" sends it directly without proxy. In a dual-stack
    # environment, if the node does not support IPv6, "direct" may allow programs attempting to use an IPv6
    # connection to actually dial to the target using IPv4.
    #no_connectivity_behavior: block

    # keep (default) or close old connections after a device joins/leaves a client set
    # used by routing, or after a group recovers from direct fallback. Membership changes
    # affect the whole device; recovery affects only that group/network's fallback flows.
    #route_change_behavior: keep
}

# Subscriptions defined here will be resolved as nodes and merged as a part of the global node pool.
# Support to give the subscription a tag, and filter nodes from a given subscription in the group section.
subscription {
    # Add your subscription links here.
    my_sub {
        link: 'https://www.example.com/subscription/link'

        # dae-specific options can be applied to selected nodes without changing their share links.
        option {
            # Apply an option to every node from this subscription.
            #multiplex: smux
            #multiplex_max_connections: 10
            # Use smux for TCP while keeping UDP on the underlying protocol.
            #multiplex: smux-udp-passthrough

            # Or match parsed node properties. Later matching rules override earlier ones.
            #filter: protocol(shadowsocks) && name(regex: '^HK') [multiplex: smux]
            #filter: name(HK-legacy) [multiplex: off]
        }
    }
    another_sub: 'https://example.com/another_sub'
    'https://example.com/no_tag_link'
    'file:relative/path/to/mysub.sub' # Resolved from the entry configuration directory, independent of DAE_LOCATION_CACHE.
    # local_sub: 'file:///var/lib/dae/nodes.sub' # Absolute local file; use file:/// with three slashes.

    # global.resource_cache defaults to true for all HTTP(S) sources, named or anonymous.
    # Validated snapshots live in DAE_LOCATION_CACHE/resources/subscriptions/.
    # Invalid responses (including HTTP 200 timeout/error pages) never replace the cache.
}

# Nodes defined here will be merged as a part of the global node pool.
node {
    # Add your node links here.
    # Each entry must contain exactly one share link. Build proxy chains with path expressions below.
    # Support socks5, http, https, ss, ssr, vmess, vless, trojan, tuic, juicity, hysteria2, etc.
    # Full support list: https://github.com/daeuniverse/dae/blob/main/docs/en/proxy-protocols.md
    'socks5://localhost:1080'
    mylink: 'ss://LINK'
    #multiplexed_ss: 'ss://LINK' [multiplex: smux, multiplex_max_connections: 10]
    #tcp_multiplexed_ss: 'ss://LINK' [multiplex: smux-udp-passthrough]
    node1: 'vmess://LINK'
    node2: 'vless://LINK'
    hysteria2: 'hysteria2://password@server-ip:port/?sni=domain'
}

# TCP/UDP destination port 53 is automatically relayed to its routed destination.
# Core DNS has no resolver policy/cache. Observed A/AAAA mappings are persisted in
# $DAE_LOCATION_CACHE/domain-registry.json (default /var/lib/dae).
# Optional DNS router/cache configuration: docs/en/configuration/dns.md.

# Node group (outbound).
group {
    my_group {
        # With no paths or filters, use the unique node matching this group's name.
        # If no node has that name, use all nodes. Multiple same-name nodes are ambiguous.

        # Randomly select a node from the group for every connection.
        #policy: random

        # Select the first node from the group for every connection.
        #policy: fixed(0)

        # Restore the saved choice, or initially use the first node; no default/reset.
        #policy: selector
        # Explicitly configure a default and enable Reset to default:
        #policy: selector(0)
        # For selector only: continuously check all nodes instead of testing on demand.
        #track_all: true

        # Select the node with min last latency from the group for every connection.
        #policy: min

        # Select the node with min moving average of latencies from the group for every connection.
        policy: min_moving_avg

        # Keep or close this group's old connections when its selected node changes.
        # Applies to the changed TCP/UDP and IPv4/IPv6 combination; unsupported with random.
        #reselect_behavior: keep
    }

    entry_path {
        # A group without policy is a reusable path. When routing references it directly,
        # it must expand to exactly one complete path.
        filter: name(node1)
    }

    group2 {
        # Filter nodes from the global node pool defined by the subscription and node section above.
        #filter: subtag(my_sub) && !name(keyword: 'ExpireAt:')
        # Multiple filters indicate 'or' logic.
        #filter: subtag(regex: '^my_', another_sub) && !name(keyword: 'ExpireAt:')

        # Filter nodes from the global node pool defined by tag.
        #filter: name(node1, node2)

        # Bind the local connection to the first proxy, including its bootstrap DNS.
        # Omitted mark inherits global.so_mark_from_dae; explicit mark: 0 uses zero.
        #filter: subtag(my_sub) [mark: 0x20, interface: wan0]

        # Split only when DNS and the local/bound interface support both families.
        # Rediscover families on reload; IPv4 candidates precede IPv6 candidates.
        # Restrict the entry connection's family; this is not the destination family.
        #filter: subtag(my_sub) && ipversion(4) [mark: 0x20, interface: wan0]
        # mark/interface/ipversion are valid only on the first stage of a chain.

        # Filter nodes and give a fixed latency offset to archive latency-based failover.
        # In this example, there is bigger possibility to choose US node even if original latency of US node is higher.
        group(entry_path) -> filter: name(HK_node)
        group(entry_path) -> filter: name(US_node) [add_latency: -500ms]

        # Select the node with min average of the last 10 latencies from the group for every connection.
        policy: min_avg10

        # group(entry_path) expands every path declared by the policyless group.
        # Physical order: client -> entry_path -> selected group2 node -> destination.
    }

    steam {
        # Filter nodes from the global node pool defined by the subscription and node section above.
        filter: subtag(my_sub) && !name(keyword: 'ExpireAt:')
        # Select the node with min moving average of latencies from the group for every connection.
        policy: min_moving_avg

        # Override udp_check_dns in global
        #udp_check_dns: 'dns.google:53,8.8.8.8,2001:4860:4860::8888'
        # Override check_interval in global
        #check_interval: 3m
        # Override check_interval_max in global
        #check_interval_max: 1h
        # Override check_tolerance in global
        #check_tolerance: 50ms
        # Skip startup waiting for this entire group. Defaults to true if all routing uses
        # have skip_while_noalive (also if unused); a fallback reference defaults to false.
        #check_async: true
    }
}

# Optional descriptions and netfilter exports for dynamic client MAC sets.
client {
    #work {
    #    description: 'Join the work device set'
    #    ipset: dae_work
    #    nftset: 'inet/filter/dae_work'
    #}
}

# Optional HTTP/HTTPS processing. Disabled until CA, client selection and modules are ready.
# Copy examples/surge/{demo.sgmodule,request.js,response.js} to $DAE_LOCATION_CACHE/modules/.
# Generate a CA with "dae mitm ca generate" and install/trust it on the selected clients before enabling.
# Capture retains each scope's hostname/IP and port constraints; unrelated direct stays in eBPF.
# Domain capture needs DNS mappings. Literal IP scopes do not; final HTTP matching still uses Host/SNI.
# Request-transforming modules run before final upstream routing, including block.
# Pure inspection retains the kernel route. Excluded clients follow ordinary routing.
# See docs/zh/configuration/mitm-plugins.md and docs/zh/configuration/surge-module.md.
mitm {
    enabled: false
    ca_cert: 'mitm-ca.pem'
    ca_key: 'mitm-ca.key'
    # Replace with a client MAC, IP or CIDR. Omitted/unmatched clients bypass HTTP processing.
    # The page/API can override this selection per device; use 'all' to explicitly select all clients.
    client_source_address: '02:00:00:00:00:50'
}

plugins {
    # A section name is the instance ID and defaults to its plugin type.
    # plugins.cfg selects surge by default; add external Go plugins there and run make.
    surge {
        enabled: false
        module {
            demo: 'file:modules/demo.sgmodule'
            # global.resource_cache controls module/dependency snapshots as one group.
            #remote: 'https://example.com/module.sgmodule'
        }
        # Default: persist scripts' data in plugins/<instance ID>/surge-store.json.
        # Set false for instance-local memory only.
        store: true
        script_timeout: 5s
        memory_limit: 134217728
        max_body_size: 33554432
        max_concurrent_scripts: 16
    }

    # Multiple instances can use the same type. Declaration order determines processing order.
    #work {
    #    type: surge
    #    enabled: false
    #    module { work: 'file:modules/work.sgmodule' }
    #}
}

# Flow controls and destination IP/port overrides, independent of MITM.
# Filters use the routing syntax. must, bump and DNAT can apply to the same connection.
# Destination matching runs before flow controls, followed by outbound routing.
# Flow controls accumulate; a bump does not hide later must/capture effects.
# Destination candidates hand off before flow controls; routing uses the rewritten IP and port.
# Source, interface, process and Host/SNI identity remain available after rewriting.
# Domain conditions use existing DNS mappings in the kernel; no implicit all-traffic capture.
# See docs/zh/configuration/destination-rules.md.
rules {
    # Skip automatic DNS interception; routing still selects direct/proxy/block.
    #pname(mosdns) -> must

    # Require userspace routing for matching traffic.
    #domain(full: api.example.com) && l4proto(tcp) -> bump

    # First matching DNAT wins; Host/SNI are preserved.
    # Native DNAT applies before routing to direct/proxy/block, before Surge [Host].
    # In userspace, DNAT domain filters (including negation) need a sniffed hostname.

    # Rewrite both destination IP and port. Quote the entire target because ':' separates named parameters.
    # IPv6 targets with a port use '[IP]:port'; keep the brackets inside the quotes.
    #dip(192.0.2.53) && dport(53) -> dnat('198.51.100.53:1053')
    #dip('2001:db8::53') && dport(53) -> dnat('[2001:db8::54]:1053')

    # Omit the target port to keep the original port. IPv6 literals still need quotes.
    #domain(full: api.example.com) && dport(443) -> dnat(198.51.100.20)
    #sip(192.168.10.0/24) && dip(192.0.2.0/24) -> dnat(198.51.100.30)
    #ipversion(6) && domain(suffix: example.net) -> dnat('2001:db8::20')
}

# See https://github.com/daeuniverse/dae/blob/main/docs/en/configuration/routing.md for full examples.
routing {
    # Reusable fragments contain rules and nested use statements, without a fallback.
    # use: a, b inserts both rule sets at that position, in order.
    # condition -> use(a, b) adds the condition to every referenced rule; nested conditions are ANDed.
    rule_set {
        base {
            # Keep local network managers direct so WAN capture does not break connectivity checks.
            pname(NetworkManager) -> direct

            # Keep broadcast, multicast and private destinations on the local network.
            # "dip" means destination IP. Remove the private rule if your proxy should reach these addresses.
            dip(224.0.0.0/3, 'ff00::/8') -> direct
            dip(geoip:private) -> direct
        }

        regional {
            # Disable h3 because it usually consumes too much CPU/memory.
            l4proto(udp) && dport(443) -> block
            dip(geoip:cn) -> direct
            domain(geosite:cn) -> direct
        }
    }

    policy {
        main {
            use: base

            ### Write your rules below. Rules are evaluated in statement order.

            # A routing target may be a uniquely named node. Quote names containing spaces or non-ASCII text.
            #domain(full: special.example) -> 'Hong Kong 01'(skip_while_noalive)

            # Devices join or leave this MAC set through the page/API. See docs/en/configuration/api.md.
            #client(proxy_devices) -> my_group

            # Apply a shared fragment only to this subnet (as an alternative to the unconditional use below).
            #sip(192.168.10.0/24) -> use(regional)

            use: regional
            fallback: my_group
        }

        # Optional independent policy for local traffic.
        #lan {
        #    use: base, regional
        #    fallback: direct
        #}
    }

    # Traffic without an interface binding uses this named policy.
    default: main

    # Each exact device name selects one policy. Multiple devices can share it.
    # Configure global.lan_interface/wan_interface separately to capture traffic.
    #interface {
    #    br-lan: lan
    #    eth1: lan
    #    wg0: main
    #}

    # Every policy declares exactly one fallback, used only after its rules.
    # For a single default policy, rules/use/fallback may be written directly under routing
    # alongside declarations; this anonymous form cannot be combined with default: name.
    # MITM plugins, native DNAT rules and Surge Host mappings automatically share a capture fragment
    # before every policy. Do not duplicate control_plane_routing rules or add a use for that fragment.
}
