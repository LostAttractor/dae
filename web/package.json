{
  "name": "dae-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && node --import tsx build.ts",
    "test:dev": "node --import tsx --test tests/api.ts tests/cdp.test.ts tests/dev-server.ts",
    "test": "node --import tsx tests/browser.ts",
    "test:certificate": "node --import tsx tests/certificate.ts",
    "test:session": "node --import tsx tests/session.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "types:api": "node --import tsx tooling/generate-api-types.ts",
    "types:check": "node --import tsx tooling/generate-api-types.ts --check"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.19.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "devtools-protocol": "0.0.1744848",
    "esbuild": "0.28.2",
    "openapi-typesafe": "1.0.0-rc.14",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
