{
  "openapi": "3.1.0",
  "info": {"title": "dae decision explanations and client administration", "version": "1"},
  "paths": {
    "/api/device/context": {"get": {"summary": "Get verified LAN identity and inheritable context", "responses": {"200": {"description": "Current device context", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeviceContext"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/device/diagnostics/explain": {"post": {"summary": "Explain a new flow for the verified LAN device", "description": "Read-only. Requires X-Dae-API: 1 and direct LAN identity. Identity overrides are rejected. Request limit 64 KiB, evaluation budget five seconds. No DNS queries, connections or scripts are executed.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExplainRequest"}}}}, "responses": {"200": {"description": "Explanation and optional same-snapshot comparison", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExplainResponse"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/diagnostics/explain": {"post": {"summary": "Explain using administrator-supplied context", "description": "Management authorization and X-Dae-API: 1 required. Read-only, 64 KiB request limit. Missing context produces incomplete results, never fabricated zero-valued identity.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExplainRequest"}}}}, "responses": {"200": {"description": "Explanation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExplainResponse"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/device/sets/{name}/impact": {"parameters": [{"$ref": "#/components/parameters/Name"}], "post": {"summary": "Preview a current-device membership change", "description": "Verified LAN identity and X-Dae-API: 1 required. Does not change membership. Supply flow for before/after routing analysis.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientImpactRequest"}}}}, "responses": {"200": {"description": "Membership impact", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientImpact"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/clients/{name}/impact": {"parameters": [{"$ref": "#/components/parameters/Name"}], "post": {"summary": "Preview membership for a specified MAC", "description": "Management authorization and X-Dae-API: 1 required. Read-only, 64 KiB request limit.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientImpactRequest"}}}}, "responses": {"200": {"description": "Membership impact", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientImpact"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/clients": {"get": {"summary": "List active client groups and MAC members", "description": "Management authorization required.", "responses": {"200": {"description": "Client groups", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientGroups"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/clients/{name}": {"parameters": [{"$ref": "#/components/parameters/Name"}], "get": {"summary": "Get a client group", "description": "Management authorization required.", "responses": {"200": {"description": "Client group", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientGroup"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/clients/{name}/members/{mac}": {
      "parameters": [{"$ref": "#/components/parameters/Name"}, {"$ref": "#/components/parameters/MAC"}],
      "put": {"summary": "Join a group by MAC", "description": "Management authorization, X-Dae-API: 1 and an empty body required. Uses the runtime settings persistence and rollback path.", "responses": {"200": {"description": "Updated group", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientGroup"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}},
      "delete": {"summary": "Leave a group by MAC", "description": "Management authorization, X-Dae-API: 1 and an empty body required.", "responses": {"200": {"description": "Updated group", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientGroup"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}
    },
    "/api/devices/{mac}": {"parameters": [{"$ref": "#/components/parameters/MAC"}], "get": {"summary": "Get saved device settings by MAC", "description": "Management authorization required. A null MITM override means configuration defaults, whose effective value may depend on source IP.", "responses": {"200": {"description": "Saved device settings", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ManagedDevice"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}},
    "/api/devices/{mac}/mitm": {
      "parameters": [{"$ref": "#/components/parameters/MAC"}],
      "put": {"summary": "Set a device MITM override", "description": "Management authorization, X-Dae-API: 1 and X-Dae-MITM containing the current CA fingerprint required.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "./openapi.json#/components/schemas/SetMITMRequest"}}}}, "responses": {"200": {"description": "Updated device", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ManagedDevice"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}},
      "delete": {"summary": "Restore a device's configured MITM default", "description": "Management authorization, X-Dae-API: 1, X-Dae-MITM containing the current CA fingerprint and an empty body required.", "responses": {"200": {"description": "Updated device", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ManagedDevice"}}}}, "default": {"$ref": "./openapi.json#/components/responses/Error"}}}
    }
  },
  "components": {
    "parameters": {
      "Name": {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}},
      "MAC": {"name": "mac", "in": "path", "required": true, "schema": {"type": "string"}, "description": "Nonzero unicast Ethernet MAC."}
    },
    "schemas": {
      "DiagnosticContext": {"type": "object", "additionalProperties": false, "properties": {
        "origin": {"type": "string", "enum": ["lan", "local", "daemon"]}, "source_ip": {"type": "string"}, "source_port": {"type": "integer", "minimum": 0, "maximum": 65535}, "mac": {"type": "string"}, "interface": {"type": "string"}, "ifindex": {"type": "integer"}, "physical_ifindex": {"type": "integer"}, "process_name": {"type": "string"}, "dscp": {"type": "integer", "minimum": 0, "maximum": 63}, "mark": {"type": "integer"}, "policy": {"type": "string"}
      }},
      "DiagnosticTarget": {"type": "object", "additionalProperties": false, "properties": {"ip": {"type": "string"}, "domain": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
      "DiagnosticHTTP": {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {
        "url": {"type": "string"}, "method": {"type": "string"}, "host": {"type": "string"}, "headers": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}, "response_status": {"type": "integer"}, "response_headers": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }},
      "DiagnosticFlow": {"type": "object", "additionalProperties": false, "required": ["destination"], "properties": {"protocol": {"type": "string", "enum": ["tcp", "udp"]}, "destination": {"$ref": "#/components/schemas/DiagnosticTarget"}, "sni": {"type": "string"}, "http": {"$ref": "#/components/schemas/DiagnosticHTTP"}}},
      "DiagnosticDNS": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {
        "name": {"type": "string"}, "type": {"type": "string"}, "class": {"type": "string"}, "upstream": {"type": "string"}, "answer_ips": {"type": "array", "items": {"type": "string"}}, "rcode": {"type": "integer"}, "rd": {"type": "boolean"}, "cd": {"type": "boolean"}, "do": {"type": "boolean"}, "udp_size": {"type": "integer"}
      }},
      "DiagnosticBinding": {"type": "object", "additionalProperties": false, "required": ["ip", "domains"], "properties": {"ip": {"type": "string"}, "domains": {"type": "array", "items": {"type": "string"}}}},
      "DiagnosticAssumptions": {"type": "object", "additionalProperties": false, "properties": {"client_sets": {"type": "object", "additionalProperties": {"type": "boolean"}}, "mitm": {"type": "boolean"}, "bindings": {"type": "array", "items": {"$ref": "#/components/schemas/DiagnosticBinding"}}, "outbounds": {"type": "object", "additionalProperties": {"type": "boolean"}}}},
      "ExplainRequest": {"type": "object", "additionalProperties": false, "required": ["context", "flow"], "properties": {"kind": {"type": "string", "enum": ["flow", "dns", "domain", "outbound", "plugins"]}, "context": {"$ref": "#/components/schemas/DiagnosticContext"}, "flow": {"$ref": "#/components/schemas/DiagnosticFlow"}, "dns": {"$ref": "#/components/schemas/DiagnosticDNS"}, "outbound": {"type": "string"}, "network": {"type": "string"}, "compare": {"$ref": "#/components/schemas/DiagnosticAssumptions"}, "detail": {"type": "string", "enum": ["rules", "predicates"]}}},
      "DiagnosticField": {"type": "object", "required": ["name", "value", "source"], "properties": {"name": {"type": "string"}, "value": {"type": "string"}, "source": {"type": "string"}}},
      "DiagnosticSource": {"type": "object", "required": ["expression"], "properties": {"file": {"type": "string"}, "line": {"type": "integer"}, "column": {"type": "integer"}, "expression": {"type": "string"}}},
      "ExplainCondition": {"type": "object", "required": ["expression", "match", "status", "reason", "actual", "expected"], "properties": {"expression": {"type": "string"}, "match": {"type": "string"}, "status": {"type": "string"}, "reason": {"type": "string"}, "actual": {"type": "string"}, "expected": {"type": "string"}}},
      "ExplainStep": {"type": "object", "required": ["id", "stage", "expression", "status", "match", "reason"], "properties": {
        "id": {"type": "string"}, "parent": {"type": "string"}, "stage": {"type": "string"}, "expression": {"type": "string"}, "sources": {"type": "array", "items": {"$ref": "#/components/schemas/DiagnosticSource"}}, "status": {"type": "string"}, "match": {"type": "string"}, "reason": {"type": "string"}, "conditions": {"type": "array", "items": {"$ref": "#/components/schemas/ExplainCondition"}}, "action": {"type": "string"}, "outbound": {"type": "string"}, "mark": {"type": "integer"}, "must": {"type": "boolean"}, "targets": {"type": "array", "items": {"type": "string"}}
      }},
      "ExplainDecision": {"type": "object", "required": ["complete", "verdict", "mark", "must"], "properties": {
        "complete": {"type": "boolean"}, "verdict": {"type": "string"}, "policy": {"type": "string"}, "rule_id": {"type": "string"}, "original_target": {"type": "string"}, "targets": {"type": "array", "items": {"type": "string"}}, "outbound": {"type": "string"}, "original_outbound": {"type": "string"}, "mark": {"type": "integer"}, "must": {"type": "boolean"}, "capture": {"type": "array", "items": {"type": "string"}}, "missing": {"type": "array", "items": {"type": "string"}}
      }},
      "DomainEvidence": {"type": "object", "required": ["domain", "ip", "resident", "source"], "properties": {"domain": {"type": "string"}, "ip": {"type": "string"}, "resident": {"type": "boolean"}, "retain_until": {"type": "string", "format": "date-time"}, "source": {"type": "string"}}},
      "ExplainNode": {"type": "object", "required": ["id", "name", "selected", "usable", "reason"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "selected": {"type": "boolean"}, "usable": {"type": "boolean"}, "reason": {"type": "string"}, "selection": {"$ref": "./openapi.json#/components/schemas/SelectionStatus"}}},
      "ExplainOutbound": {"type": "object", "required": ["name", "policy", "network", "available", "random", "observed_at", "nodes"], "properties": {"name": {"type": "string"}, "policy": {"type": "string"}, "network": {"type": "string"}, "available": {"type": "boolean"}, "random": {"type": "boolean"}, "observed_at": {"type": "string", "format": "date-time"}, "nodes": {"type": "array", "items": {"$ref": "#/components/schemas/ExplainNode"}}}},
      "ExplainResult": {"type": "object", "required": ["decision", "steps", "domains", "outbounds", "notes"], "properties": {"assumptions": {"$ref": "#/components/schemas/DiagnosticAssumptions"}, "decision": {"$ref": "#/components/schemas/ExplainDecision"}, "steps": {"type": "array", "items": {"$ref": "#/components/schemas/ExplainStep"}}, "domains": {"type": "array", "items": {"$ref": "#/components/schemas/DomainEvidence"}}, "outbounds": {"type": "array", "items": {"$ref": "#/components/schemas/ExplainOutbound"}}, "notes": {"type": "array", "items": {"type": "string"}}}},
      "ExplainResponse": {"type": "object", "required": ["schema", "generation", "observed_at", "context", "current"], "properties": {"schema": {"type": "integer", "const": 1}, "generation": {"type": "integer"}, "observed_at": {"type": "string", "format": "date-time"}, "context": {"type": "array", "items": {"$ref": "#/components/schemas/DiagnosticField"}}, "current": {"$ref": "#/components/schemas/ExplainResult"}, "compared": {"$ref": "#/components/schemas/ExplainResult"}}},
      "DeviceContext": {"type": "object", "required": ["generation", "context", "device", "fields"], "properties": {"generation": {"type": "integer"}, "context": {"$ref": "#/components/schemas/DiagnosticContext"}, "device": {"$ref": "./openapi.json#/components/schemas/DeviceState"}, "fields": {"type": "array", "items": {"$ref": "#/components/schemas/DiagnosticField"}}}},
      "ClientGroup": {"type": "object", "required": ["name", "description", "members"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "ipset": {"type": "string"}, "nftset": {"type": "string"}, "members": {"type": "array", "items": {"type": "string"}}}},
      "ClientGroups": {"type": "object", "required": ["groups"], "properties": {"groups": {"type": "array", "items": {"$ref": "#/components/schemas/ClientGroup"}}}},
      "ManagedDevice": {"type": "object", "required": ["mac", "sets", "mitm_override"], "properties": {"mac": {"type": "string"}, "sets": {"type": "array", "items": {"$ref": "./openapi.json#/components/schemas/ClientSetState"}}, "mitm_override": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}}},
      "ClientImpactRequest": {"type": "object", "additionalProperties": false, "required": ["joined", "context"], "properties": {"joined": {"type": "boolean"}, "context": {"$ref": "#/components/schemas/DiagnosticContext"}, "flow": {"$ref": "#/components/schemas/DiagnosticFlow"}}},
      "ClientImpact": {"type": "object", "required": ["generation", "name", "joined_before", "joined_after", "connection_behavior", "exports", "rules"], "properties": {"generation": {"type": "integer"}, "name": {"type": "string"}, "joined_before": {"type": "boolean"}, "joined_after": {"type": "boolean"}, "connection_behavior": {"type": "string"}, "exports": {"type": "array", "items": {"type": "string"}}, "rules": {"type": "array", "items": {"$ref": "#/components/schemas/ExplainStep"}}, "trace": {"$ref": "#/components/schemas/ExplainResponse"}}}
    }
  }
}
