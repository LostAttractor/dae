          },
          "last_check_at": {
            "format": "date-time",
            "type": "string"
          },
          "last_connection_failure_at": {
            "format": "date-time",
            "type": "string"
          },
          "last_failure_duration": {
            "description": "Duration in nanoseconds.",
            "format": "int64",
