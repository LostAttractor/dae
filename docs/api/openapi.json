{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        },
        "description": "400 invalid request; 401 wrong/missing configured token; 403 forbidden or admin token not configured; 404 absent resource; 405 unsupported method; 409 CA changed; 413 body over 1 KiB; 415 wrong media type; 500 persistence failure; 503 starting/reloading. Route/method errors and missing certificates may be plain text."
      }
    },
    "schemas": {
