          "availability",
          "support",
          "stats",
          "revision",
          "observed_session_seq",
          "recovery"
        ],
        "type": "object"
      },
      "PathStats": {
        "properties": {
          "active_connections": {
            "format": "int64",
            "type": "integer"
          },
