        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      },
      "StatusSnapshot": {
        "properties": {
          "direct_fallback_connections": {
            "description": "Process-lifetime count of established no-connectivity fallbacks to direct; preserved across reloads. Not a per-path or per-node counter.",
            "format": "int64",
            "type": "integer"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/GroupStatus"
            },
            "type": "array"
          },
          "last_reload_at": {
            "format": "date-time",
            "type": "string"
          },
          "plugins": {
            "items": {
              "$ref": "#/components/schemas/PluginInstanceStatus"
            },
            "type": "array"
          },
          "networks": {
            "description": "Network order: tcp4, tcp6, udp4, udp6.",
            "items": {
              "$ref": "#/components/schemas/PathStats"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "schema": {
            "const": 11,
            "format": "int64",
            "type": "integer"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "stats": {
            "$ref": "#/components/schemas/PathStats"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/TableUsage"
            },
            "type": "array"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "schema",
          "version",
          "started_at",
          "last_reload_at",
          "stats",
          "direct_fallback_connections",
          "networks",
          "tables",
          "groups"
        ],
        "type": "object"
      },
      "SurgeStatus": {
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleStatus"
            },
            "type": "array"
          }
        },
        "required": [
          "enabled",
          "modules"
        ],
        "type": "object"
      },
      "TableUsage": {
        "properties": {
          "candidates": {
            "description": "IP states with a nonzero domain bitmap before capacity selection. candidates - used is the number excluded by kernel capacity.",
            "format": "int64",
            "type": "integer"
          },
          "breakdown": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TableUsageBreakdown"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "used": {
            "description": "Resident IP count for domain-kernel; retained domain-IP pair count for domain-registry.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "used",
          "limit"
        ],
        "type": "object"
      },
      "TableUsageBreakdown": {
        "properties": {
          "domains": {
            "description": "Distinct retained domain names, including evidence not projected into the kernel.",
            "minimum": 0,
            "format": "int64",
            "type": "integer"
          },
          "ips": {
            "description": "Distinct retained IPs across all domains; equals ipv4 + ipv6. A shared IP counts once.",
            "minimum": 0,
            "format": "int64",
            "type": "integer"
          },
          "ipv4": {
            "description": "Distinct retained IPv4 addresses, not domain-IP pairs.",
            "minimum": 0,
            "format": "int64",
            "type": "integer"
          },
          "ipv6": {
            "description": "Distinct retained IPv6 addresses, not domain-IP pairs.",
            "minimum": 0,
            "format": "int64",
            "type": "integer"
          },
          "gc": {
            "description": "Pairs removed by time-based GC, cumulative across reload and reset on cold start. Unsigned 64-bit count; JavaScript clients must account for integer precision above 2^53-1.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "domains",
          "ips",
          "ipv4",
          "ipv6",
          "gc"
        ],
        "type": "object"
      },
      "TrafficHistory": {
        "properties": {
          "download_bytes_per_second": {
            "description": "Oldest first; completed 5-second averages in bytes/second. Both directions have equal length, 0–12 samples.",
            "items": {
              "description": "Unsigned 64-bit count; JavaScript clients must account for integer precision above 2^53-1.",
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 12,
            "type": "array"
          },
          "upload_bytes_per_second": {
            "description": "Oldest first; completed 5-second averages in bytes/second. Both directions have equal length, 0–12 samples.",
            "items": {
              "description": "Unsigned 64-bit count; JavaScript clients must account for integer precision above 2^53-1.",
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 12,
            "type": "array"
          }
        },
        "required": [
          "upload_bytes_per_second",
          "download_bytes_per_second"
        ],
        "type": "object"
      },
      "ResourceRef": {
        "properties": {
          "owner_id": {
            "format": "int64",
            "type": "integer"
          },
          "resource_id": {
            "format": "int64",
            "type": "integer"
          },
          "generation": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "owner_id",
          "resource_id",
          "generation"
        ],
        "type": "object",
        "description": "Unsigned resource identifiers; generations are comparable only within the same owner and resource."
      },
      "RecoverySnapshot": {
        "properties": {
          "executor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "enum": [
              "cleanup",
              "waiting_dependency",
              "queued",
              "backoff",
              "connecting",
              "verifying",
              "ready",
              "blocked",
              "stopped"
            ]
          },
          "verification": {
            "type": "string"
          },
          "attempt": {
            "format": "int64",
            "type": "integer"
          },
          "retry_at": {
            "format": "date-time",
            "type": "string",
            "description": "Actual timer deadline, present only during backoff. Omitted when no retry timer is owned."
          },
          "blocked_by": {
            "type": "string"
          }
        },
        "required": [
          "phase",
          "verification",
          "attempt"
        ],
        "type": "object"
      },
      "FailureSnapshot": {
        "properties": {
          "episode_id": {
            "format": "int64",
            "type": "integer"
          },
          "resource": {
            "$ref": "#/components/schemas/ResourceRef"
          },
          "scope": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "episode_id",
          "resource",
          "scope",
          "layer",
          "phase",
          "origin",
          "reason",
          "occurred_at",
          "message"
        ],
        "type": "object",
        "description": "Classified failure metadata; message is display text and must not be used as a metric label."
      },
      "SessionStatus": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "disconnected",
              "connecting",
              "connected",
              "closed"
            ]
          },
          "seq": {
            "format": "int64",
            "type": "integer"
          },
          "readiness_version": {
            "format": "int64",
            "type": "integer"
          },
          "resource": {
            "$ref": "#/components/schemas/ResourceRef"
          },
          "episode_id": {
            "format": "int64",
            "type": "integer"
          },
          "accepting": {
            "type": "boolean"
          },
          "usable_capacity": {
            "format": "int64",
            "type": "integer"
          },
          "recovery_required": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "seq",
          "readiness_version",
          "resource",
          "episode_id",
          "accepting",
          "usable_capacity",
          "recovery_required"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
