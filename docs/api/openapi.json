            "type": "integer"
          },
          "checks_since_alive": {
            "format": "int64",
            "type": "integer"
          },
          "checks_total": {
            "format": "int64",
            "type": "integer"
          },
          "last_check_at": {
            "format": "date-time",
            "type": "string"
          },
          "last_connection_failure_at": {
            "format": "date-time",
            "type": "string"
          },
          "last_failure_duration": {
            "description": "Duration in nanoseconds.",
            "format": "int64",
            "type": "integer"
          },
          "last_failure_started_at": {
            "format": "date-time",
            "type": "string"
          },
          "recent_24h": {
            "$ref": "#/components/schemas/AvailabilityWindow"
          },
          "seen": {
            "type": "boolean"
          },
          "up_ratio": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "seen",
          "alive",
          "alive_since",
          "last_failure_started_at",
          "last_failure_duration",
          "last_check_at",
          "last_connection_failure_at",
          "up_ratio",
          "checks_total",
          "checks_failed",
          "checks_since_alive",
          "recent_24h"
        ],
        "type": "object"
      },
