{
  "name": "dae",
  "private": true,
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "version": "1.0.0",
  "author": "LostAttractor",
  "license": "AGPL-3.0-only",
  "repository": "github:LostAttractor/dae",
  "scripts": {
    "check-broken-link": "node hack/docs/check-links.mjs ./docs/ ./plugins/ pkg/outbound/README.md component/plugin/README.md 'README*.md'",
    "markdown-lint": "markdownlint --config .markdownlint.jsonc --rules ./hack/docs/markdown-rules.cjs './docs/**/*.md' './plugins/**/*.md' pkg/outbound/README.md component/plugin/README.md 'README*.md'",
    "markdown-lint-fix": "pnpm run markdown-lint --fix",
    "test-doc-tools": "node --test hack/docs/docs.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "markdownlint-cli": "^0.50.0",
    "markdownlint-rule-enhanced-proper-names": "^0.0.1",
    "markdownlint-rule-no-trailing-slash-in-links": "^0.0.2",
    "remark": "^15.0.1",
    "remark-validate-links": "^13.1.0",
    "unified-engine": "^11.2.2",
    "unist-util-visit": "^5.2.0"
  },
  "remarkConfig": {
    "plugins": [
      "./hack/docs/heading-ids.mjs",
      "remark-validate-links"
    ]
  },
  "engines": {
    "node": ">=26.13"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
